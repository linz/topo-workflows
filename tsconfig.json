{
  "extends": "@linzjs/style/tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2022"],
    "target": "ES2022",
    "types": ["node"],
    "outDir": "build",
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "erasableSyntaxOnly": true,
    "verbatimModuleSyntax": true
  },
  "include": ["infra/", "templates/common/__test__/"]
}
